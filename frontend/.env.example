# Where market data comes from:
#   api  = real NSE data from the backend (default)
#   demo = synthetic prices generated in the browser, no backend needed
VITE_DATA_SOURCE=api

# Backend URL. Leave unset for local development (Vite proxies /api to
# localhost:5000). On Vercel set it to your Render URL + /api, e.g.
# VITE_API_BASE_URL=https://stock-scanner-api.onrender.com/api
