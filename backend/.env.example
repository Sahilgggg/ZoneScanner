# Copy to .env and adjust.
PORT=5000

# Local MongoDB, or a MongoDB Atlas connection string.
# If MongoDB is not reachable the API still runs with an in-memory cache.
MONGODB_URI=mongodb://127.0.0.1:27017/stock-scanner

# Allowed frontend origins, comma-separated; "*" is a wildcard.
# Production example: https://your-app.vercel.app,https://your-app-*.vercel.app
CORS_ORIGIN=http://localhost:5173

# Re-download a stock's latest candles when the cache is older than this.
CACHE_TTL_MINUTES=30

# Re-download NSE index lists after this many hours.
INDEX_TTL_HOURS=24

# Max simultaneous requests to Yahoo Finance.
YAHOO_CONCURRENCY=4

# Stock histories kept in RAM (~0.5 MB each). Use ~100 on small instances.
MEMORY_CACHE_SYMBOLS=150

# Rebuild the equal-weighted sector indices after this many hours.
SECTOR_TTL_HOURS=12
